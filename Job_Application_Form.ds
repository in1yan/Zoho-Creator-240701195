		workflow
		{
		form
		{
			Send_Email_Form_Propertie as "Send Email - Form Properties"
			{
				type =  presuccess
				form = Application
				on start
				{
					actions 
					{
						sendmail
						(
							from : "zoho.adminuserid"
							to : Email_Address
							subject : "Job Applied Successfully"
							message : "Hello ${Candidate_Name.first_name},<br>Your Job Application is currently under review.<span style=\"font-family: Poppins, sans-serif;\" class=\"font\">​</span><div><br></div>"
							attachments : template : _default as inline
						)
					}
				}
			}
		}






	}
