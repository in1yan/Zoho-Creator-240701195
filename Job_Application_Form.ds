 * Generated on : 10-Oct-2026 18:02:47
 * Version      : 1.0
 */
 application "Job Application Form"
 {
 	date format = "dd-MMM-yyyy"
 	time zone = "Asia/Kolkata"
 	time format = "24-hr"

 	forms
	{
		form Application
		{
			success message = "Applied Successfully!"
			Personal_DetailA
			(
				type = section
				displayname = "Personal Details"
				visibility = true
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have Candidate_Name
			(
    			type = name
     			prefix
     			(
	     			 type = prefix
	     			 displayname ="Prefix"
	     			 visibility = false
	     			 value = {"Mr.","Mrs.","Ms."}
     			) 
     			first_name
     			(
	     			 type = first_name
	     			 displayname ="First Name"
     			) 
     			last_name
     			(
	     			 type = last_name
	     			 displayname ="Last Name"
     			) 
     			suffix
     			(
	     			 type = suffix
	     			 displayname ="Suffix"
	     			 visibility = false
     			) 
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
			)
			must have Current_Address
			(
    			type = address
     			capture_coordinates = true
     			adjust_using_map = false
     			address_line_1
     			(
	     			  type = address_line_1
	     			  displayname = "Address Line 1"
     			) 
     			address_line_2
     			(
	     			  type = address_line_2
	     			  displayname = "Address Line 2"
     			) 
     			district_city
     			(
	     			  type = district_city
	     			  displayname = "City / District"
     			) 
     			state_province
     			(
	     			  type = state_province
	     			  displayname = "State / Province"
     			) 
     			postal_Code
     			(
	     			  type = postal_Code
	     			  displayname = "Postal Code"
     			) 
     			country
     			(
	     			  type = country
	     			  displayname = "Country"
     			) 
     			latitude
     			(
	     			  type = latitude
	     			  displayname = "latitude"
	     			 visibility = false
     			) 
     			longitude
     			(
	     			  type = longitude
	     			  displayname = "longitude"
	     			 visibility = false
     			) 
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
			)
			must have Contact_Number
			(
    			type = phonenumber
    			defaultcountry="in"
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
			)
			Contact_Online_Presence
			(
				type = section
				displayname = "Contact & Online Presence"
				visibility = true
	 			row = 2
	 			column = 0   
				width = medium
			)
			must have Email_Address
			(
    			type = email
				maxchar = 80
	 			row = 2
	 			column = 1   
				width = medium
				personal data = true
			)
			LinkedIn_Profile
			(
    			type = text
	 			row = 2
	 			column = 1   
				width = medium
			)
			SectionC
			(
				type = section
				displayname = "Job & Experience Details"
				visibility = true
	 			row = 3
	 			column = 0   
				width = medium
			)
			must have Department_Applied_For
			(
				type = picklist
				maxchar = 100
				values = {"Software Department","HR Department","IT Department"}
	 			row = 3
	 			column = 1   
				width = medium
			)
			must have Employment_Type_Preferred
			(
				type = radiobuttons
				maxchar = 100
				values = {"Full-Time","Part-Time","Internship"}
	 			row = 3
	 			column = 1   
				width = medium
			)
			Years_Of_Experience
			(
				type = number
				maxchar = 2
				initial value = 0
	 			row = 3
	 			column = 1   
				width = 200px
			)
			Key_Skills
			(
				type = list	
				values = {"HTML","CSS","PYTHON","COMMUNICATION","RUST","C"}
				height = 60px
	 			row = 3
	 			column = 1   
				width = medium
			)
			Available_Joining_Date
			(
    			type = date
				alloweddays = 1,2,3,4,5
	 			row = 3
	 			column = 1   
				width = medium
			)
			SectionD
			(
				type = section
				displayname = "Interview_Scheduling_Consent"
				visibility = true
	 			row = 4
	 			column = 0   
				width = medium
			)
			Preferred_Interview_Time
			(
    			type = time
				timedisplayoptions = "hh:mm:ss" 
	 			row = 4
	 			column = 1   
				width = medium
			)
			Cover_Letter
			(
    			type = textarea
				height = 100px
	 			row = 4
	 			column = 1   
				width = medium
			)
			must have Background_Verification_Consent
			(
				type = checkboxes	
				values = {"Agree"}
	 			row = 4
	 			column = 1   
				width = medium
			)
			Academic_Referral_Verification
			(
				type = section
				displayname = "Academic & Referral Verification"
				visibility = true
	 			row = 5
	 			column = 0   
				width = medium
			)
			Referral_Employee_Lookup
			(
				type = picklist	
				displayname = "Referral Employee Lookup"
				values  = Employee_details.ID
    			displayformat = [" " + Name.prefix + " " + Name.first_name + " " + Name.last_name + " " + Name.suffix]
				sortorder = ascending
	 			row = 5
	 			column = 1   
				width = medium
			)
			must have Candidate_Image
			(
    			type = image
				displayname = "Candidate Image"
				source  = file
				aspect ratio = original
				camera = primary
				show gallery = true
				switch camera = true
	 			row = 5
	 			column = 1   
				width = medium
				personal data = true
			)
			must have Resume_Upload
			(
    			type = upload file
				displayname = "Resume Upload"
				browse = local_drive, google_docs, zoho_docs
				allowed file formats = {"pdf","docx"}
	 			row = 5
	 			column = 1   
				width = medium
				personal data = true
			)
			CGPA
			(
				type = decimal
				maxchar = 13
	 			row = 5
	 			column = 1   
				width = medium
			)
			Previous_Employment_Details
			(
				type = grid
				displayname = "Previous Employment Details"
				maxrow = 6
				Company_Name
				(
    				type = text
					displayname = "Company Name"
					width = medium
				)
				Designation
				(
    				type = text
					width = medium
				)
				From
				(
    				type = date
					alloweddays = 0,1,2,3,4,5,6
					width = medium
				)
				Date_field1
				(
    				type = date
					displayname = "Date"
					alloweddays = 0,1,2,3,4,5,6
					width = medium
				)
	 			row = 6
	 			column = 1   
				width = medium
			)
			Media_Details
			(
				type = section
				displayname = "Media Details"
				visibility = true
	 			row = 7
	 			column = 0   
				width = medium
			)
			must have portfolio_url
			(
    			type = text
				displayname = "Portfolio/Github url"
	 			row = 7
	 			column = 1   
				width = medium
			)
			video_resume
			(
    			type = video
				displayname = "Video Resume"
    			duration=90
	 			row = 7
	 			column = 1   
				width = medium
			)
			Self_Introduction_Audio
			(
     			type = audio
				displayname = "Self Introduction Audio"
    			duration=60
	 			row = 7
	 			column = 1   
				width = medium
			)
			Compensation_Relocation
			(
				type = section
				displayname = "Compensation & Relocation"
				visibility = true
	 			row = 8
	 			column = 0   
				width = medium
			)
			Willing_to_relocate1
			(
    			type = checkbox
				displayname = "Willing to relocate"
				initial value = false
	 			row = 8
	 			column = 1   
				width = medium
			)
			Current_Annual_CTC
			(
				displayname = "Current Annual CTC"
				type = INR
				format = commadotindian
	 			row = 8
	 			column = 1   
				width = medium
			)
			Expected_Salary_Hike_Percent
			(
    			type = percentage
				displayname = "Expected Salary Hike Percent"
	 			row = 8
	 			column = 1   
				width = medium
			)
			Expected_Annual_CTC
			(
				type = decimal
	 			row = 8
	 			column = 1   
				width = medium
    			Formula_Properties
    			(
    						value =  input.Current_Annual_CTC + input.Current_Annual_CTC * input.Expected_Salary_Hike_Percent
    						visibility = true
    			)
			)
			Declaration_System_Generated_Values
			(
				type = section
				displayname = "Declaration & System-Generated Values"
				visibility = true
	 			row = 9
	 			column = 0   
				width = medium
			)
			Company_Culture_Display
			(
    			type = richtext
				displayname = "Company Culture Display"
				height = 200px
				toolbar = enable
				[
					style, font-color, background-color, link, bullets-and-numbering, 
					font-size : {1, 2, 3, 4, 5, 6, 7}
				]
	 			row = 9
	 			column = 1   
				width = medium
			)
			Candidate_Digital_Signature
			(
    			type = signature
				displayname = "Candidate Digital Signature"
	 			row = 9
	 			column = 1   
				width = medium
				personal data = true
			)
			application_submitted_on
			(
    			type = datetime
				displayname = "application submitted on"
				initial value = "${zoho.currentdate}"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 9
	 			column = 1   
				width = medium
			)
			app_id
			(
    			type = autonumber
				start index = 1000
	 			row = 9
	 			column = 1   
				width = medium
			)
			QR_Code
			(
				type = qrcode
				displayname = "tracking_qr"
				value = "${app_id}"
	 			row = 9
	 			column = 1   
				width = medium
			)
			Section
			(
				type = section
				visibility = true
	 			row = 10
	 			column = 0   
				width = medium
			)
			status
			(
				type = picklist
				maxchar = 100
				values = {"Selected","Interview","Applied"}
				private = true
	 			row = 10
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form Employee_details
		{
			displayname = "Employee details"
			success message = "Data Added Successfully!"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			Employee__ID
			(
    			type = autonumber
				displayname = "Employee _ID"
				start index = 1000
	 			row = 1
	 			column = 1   
				width = medium
			)
			Name
			(
    			type = name
     			prefix
     			(
	     			 type = prefix
	     			 displayname ="Prefix"
	     			 visibility = false
	     			 value = {"Mr.","Mrs.","Ms."}
     			) 
     			first_name
     			(
	     			 type = first_name
	     			 displayname ="First Name"
     			) 
     			last_name
     			(
	     			 type = last_name
	     			 displayname ="Last Name"
     			) 
     			suffix
     			(
	     			 type = suffix
	     			 displayname ="Suffix"
	     			 visibility = false
     			) 
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
			)
			Email
			(
    			type = email
				maxchar = 80
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
	}
	reports
	{
		default list Application_Report
		{
			displayName = "Application Report"
			show all rows from Application    
			(
				Candidate_Name 
				Current_Address 
	 			(
	      			enable = Link_to_Map,Show_As_Text
	 			)
				Email_Address
				Contact_Number
				(
					displayformat = plainnumber 
				)
				LinkedIn_Profile
				Cover_Letter
				Years_Of_Experience
				Available_Joining_Date
				Preferred_Interview_Time
				Department_Applied_For
				Employment_Type_Preferred
				Key_Skills
				Background_Verification_Consent
				Referral_Employee_Lookup as "Referral Employee Lookup"
				Candidate_Image as "Candidate Image"
				Resume_Upload as "Resume Upload"
				CGPA
				Previous_Employment_Details.Company_Name as "Previous Employment Details"
				portfolio_url as "Portfolio/Github url"
				video_resume as "Video Resume"
				Self_Introduction_Audio as "Self Introduction Audio"
				app_id
				Willing_to_relocate1 as "Willing to relocate"
				Current_Annual_CTC as "Current Annual CTC"
				Expected_Salary_Hike_Percent as "Expected Salary Hike Percent"
				Expected_Annual_CTC
				Company_Culture_Display as "Company Culture Display"
				Candidate_Digital_Signature as "Candidate Digital Signature"
				application_submitted_on as "application submitted on"
				QR_Code as "tracking_qr"
				status
			)
		}
		default list Employee_details_Report
		{
			displayName = "Employee details Report"
			show all rows from Employee_details    
			(
				Name 
				Email
				Employee__ID as "Employee _ID"
			)
		}
		list All_Applications_List
		{
			displayName = "All_Applications_List"
			show all rows from Application    
			(
				Candidate_Name 
				Current_Address 
	 			(
	      			enable = Link_to_Map,Show_As_Text
	 			)
				Contact_Number
				(
					displayformat = plainnumber 
				)
				Email_Address
				LinkedIn_Profile
				Department_Applied_For
				Employment_Type_Preferred as "Candidate Name"
				Years_Of_Experience
				Key_Skills
				Available_Joining_Date
				Preferred_Interview_Time
				Cover_Letter
				Background_Verification_Consent
				Referral_Employee_Lookup as "Referral Employee Lookup"
				Candidate_Image as "Candidate Image"
				Resume_Upload as "Resume Upload"
				CGPA
				portfolio_url as "Portfolio/Github url"
				video_resume as "Video Resume"
				Self_Introduction_Audio as "Self Introduction Audio"
				Willing_to_relocate1 as "Willing to relocate"
				Current_Annual_CTC as "Current Annual CTC"
				Expected_Salary_Hike_Percent as "Expected Salary Hike Percent"
				Expected_Annual_CTC
				Company_Culture_Display as "Company Culture Display"
				Candidate_Digital_Signature as "Candidate Digital Signature"
				application_submitted_on as "application submitted on"
				app_id
				QR_Code as "tracking_qr"
			)
		}
		spreadsheet Applications_Spreadsheet
		{
			displayName = "Applications_Spreadsheet"
			show all rows from Application    
			(
				Candidate_Name 
				Current_Address 
	 			(
	      			enable = Link_to_Map,Show_As_Text
	 			)
				Contact_Number
				(
					displayformat = plainnumber 
				)
				Email_Address
				LinkedIn_Profile
				Department_Applied_For
				Employment_Type_Preferred
				Years_Of_Experience
				Key_Skills
				Available_Joining_Date
				Preferred_Interview_Time
				Cover_Letter
				Background_Verification_Consent
				Referral_Employee_Lookup as "Referral Employee Lookup"
				Candidate_Image as "Candidate Image"
				Resume_Upload as "Resume Upload"
				CGPA
				portfolio_url as "Portfolio/Github url"
				video_resume as "Video Resume"
				Self_Introduction_Audio as "Self Introduction Audio"
				Willing_to_relocate1 as "Willing to relocate"
				Current_Annual_CTC as "Current Annual CTC"
				Expected_Salary_Hike_Percent as "Expected Salary Hike Percent"
				Expected_Annual_CTC
				Company_Culture_Display as "Company Culture Display"
				Candidate_Digital_Signature as "Candidate Digital Signature"
				application_submitted_on as "application submitted on"
				app_id
				QR_Code as "tracking_qr"
			)
		}
		kanban Applications_kanban
		{
			displayName = "Applications kanban"
			show all rows from Application    
			(
				Candidate_Name 
				Current_Address 
	 			(
	      			enable = Link_to_Map,Show_As_Text
	 			)
				Contact_Number
				(
					displayformat = plainnumber 
				)
				Email_Address
				LinkedIn_Profile
				Department_Applied_For
				Employment_Type_Preferred
				Years_Of_Experience
				Key_Skills
				Available_Joining_Date
				Preferred_Interview_Time
				Cover_Letter
				Background_Verification_Consent
				Referral_Employee_Lookup as "Referral Employee Lookup"
				Candidate_Image as "Candidate Image"
				Resume_Upload as "Resume Upload"
				CGPA
				portfolio_url as "Portfolio/Github url"
				video_resume as "Video Resume"
				Self_Introduction_Audio as "Self Introduction Audio"
				Willing_to_relocate1 as "Willing to relocate"
				Current_Annual_CTC as "Current Annual CTC"
				Expected_Salary_Hike_Percent as "Expected Salary Hike Percent"
				Expected_Annual_CTC
				Company_Culture_Display as "Company Culture Display"
				Candidate_Digital_Signature as "Candidate Digital Signature"
				application_submitted_on as "application submitted on"
				app_id
				QR_Code as "tracking_qr"
				status
			)
			options
			(
	 			display field = status
	 		)
		}
		calendar Application_Calender
		{
			displayName = "Application Calender"
			show all rows from Application    
			(
				Available_Joining_Date
				QR_Code as "tracking_qr"
				Candidate_Name 
				Years_Of_Experience
				application_submitted_on as "application submitted on"
				Candidate_Digital_Signature as "Candidate Digital Signature"
				Cover_Letter
				Referral_Employee_Lookup as "Referral Employee Lookup"
				Current_Address 
	 			(
	      			enable = Link_to_Map,Show_As_Text
	 			)
				LinkedIn_Profile
				Company_Culture_Display as "Company Culture Display"
				Employment_Type_Preferred
				CGPA
				Resume_Upload as "Resume Upload"
				Department_Applied_For
				Added_Time as "Added Time"
				Candidate_Image as "Candidate Image"
				Preferred_Interview_Time
				Key_Skills
				status
				video_resume as "Video Resume"
				Email_Address
				portfolio_url as "Portfolio/Github url"
				Background_Verification_Consent
				Willing_to_relocate1 as "Willing to relocate"
				app_id
				Self_Introduction_Audio as "Self Introduction Audio"
				Expected_Annual_CTC
				Contact_Number
				(
					displayformat = plainnumber 
				)
				Expected_Salary_Hike_Percent as "Expected Salary Hike Percent"
				Current_Annual_CTC as "Current Annual CTC"
			)
			options
			(
				display field = Preferred_Interview_Time
				start date = application_submitted_on
				end date = Added_Time
			)
		}
		map Location_View
		{
			displayName = "Location View"
			show all rows from Application    
			(
				Candidate_Name 
				Current_Address 
	 			(
	      			enable = Link_to_Map,Show_As_Text
	 			)
				Contact_Number
				(
					displayformat = plainnumber 
				)
				Email_Address
				LinkedIn_Profile
				Department_Applied_For
				Employment_Type_Preferred
				Years_Of_Experience
				Key_Skills
				Available_Joining_Date
				Preferred_Interview_Time
				Cover_Letter
				Background_Verification_Consent
				Referral_Employee_Lookup as "Referral Employee Lookup"
				Candidate_Image as "Candidate Image"
				Resume_Upload as "Resume Upload"
				CGPA
				portfolio_url as "Portfolio/Github url"
				video_resume as "Video Resume"
				Self_Introduction_Audio as "Self Introduction Audio"
				Willing_to_relocate1 as "Willing to relocate"
				Current_Annual_CTC as "Current Annual CTC"
				Expected_Salary_Hike_Percent as "Expected Salary Hike Percent"
				Expected_Annual_CTC
				Company_Culture_Display as "Company Culture Display"
				Candidate_Digital_Signature as "Candidate Digital Signature"
				application_submitted_on as "application submitted on"
				app_id
				QR_Code as "tracking_qr"
				status
			)
			options
			(
	 			display field = Current_Address
	 		)
			conditional formatting
			(
				"software department"
				{
				condition = (Department_Applied_For == "Software Department")
				format = "color:#00b0ff;map-icon:weather-moon-full;map-icon-color:#ffffff;"
				}
				"HR department"
				{
				condition = (Department_Applied_For == "HR Department")
				format = "color:#cc115e;map-icon:weather-moon-full;map-icon-color:#ffffff;"
				}
				"IT department"
				{
				condition = (Department_Applied_For == "IT Department")
				format = "color:#92d191;map-icon:weather-moon-full;map-icon-color:#000000;"
				}
			)
		}
		timeline Timeline_View
		{
			displayName = "Timeline View"
			show all rows from Application    
			(
				Available_Joining_Date
				QR_Code as "tracking_qr"
				Candidate_Name 
				Years_Of_Experience
				application_submitted_on as "application submitted on"
				Candidate_Digital_Signature as "Candidate Digital Signature"
				Cover_Letter
				Referral_Employee_Lookup as "Referral Employee Lookup"
				Current_Address 
	 			(
	      			enable = Link_to_Map,Show_As_Text
	 			)
